{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-design-skill:component-bindings:0.1.0",
  "title": "Adapter-owned Component Bindings V0.1",
  "type": "object",
  "properties": {
    "metadataVersion": {
      "const": "0.1.0"
    },
    "platform": {
      "enum": [
        "figma",
        "penpot"
      ]
    },
    "scope": {
      "enum": [
        "production",
        "test-fixture"
      ]
    },
    "libraryVersion": {
      "type": "string",
      "minLength": 1
    },
    "sourceVersion": {
      "type": "string",
      "minLength": 1
    },
    "registrySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bindings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "variants": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "component"
                },
                "fileReference": {
                  "type": "string",
                  "minLength": 1
                },
                "componentReference": {
                  "type": "string",
                  "minLength": 1
                },
                "fidelityReportSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "kind",
                "fileReference",
                "componentReference",
                "fidelityReportSha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "variants"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "metadataVersion",
    "platform",
    "scope",
    "libraryVersion",
    "sourceVersion",
    "registrySha256",
    "bindings"
  ],
  "additionalProperties": false
}
