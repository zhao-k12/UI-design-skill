{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-design-skill:component-registry:0.1.0",
  "title": "Logical Component Registry V0.1",
  "type": "object",
  "properties": {
    "registryVersion": {
      "const": "0.1.0"
    },
    "libraryVersion": {
      "type": "string",
      "minLength": 1
    },
    "sourceVersion": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "production",
        "test-fixture"
      ]
    },
    "components": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "componentType": {
            "enum": [
              "Button",
              "Input",
              "Select",
              "DatePicker",
              "Table",
              "FormItem",
              "Pagination",
              "Card",
              "Tabs"
            ]
          },
          "tier": {
            "enum": [
              "base",
              "composite",
              "block"
            ]
          },
          "status": {
            "enum": [
              "planned",
              "active",
              "deprecated"
            ]
          },
          "variants": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
            }
          },
          "defaultVariant": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
          },
          "slots": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "leading-icon",
                "trailing-icon",
                "label",
                "control",
                "content",
                "actions"
              ]
            }
          },
          "fidelity": {
            "type": "object",
            "properties": {
              "reportId": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
              },
              "reportSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "componentIrSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "reportId",
              "reportSha256",
              "componentIrSha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "componentType",
          "tier",
          "status",
          "variants",
          "defaultVariant",
          "slots"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "active"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "fidelity"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "registryVersion",
    "libraryVersion",
    "sourceVersion",
    "scope",
    "components"
  ],
  "additionalProperties": false
}
