{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "pattern",
    "pageTreeSha256",
    "tokenRegistrySha256",
    "sectionRegions",
    "measurements"
  ],
  "properties": {
    "version": {
      "const": "0.1.0"
    },
    "pattern": {
      "enum": [
        "list-page",
        "detail-page",
        "form-page",
        "dashboard-basic",
        "sidebar-content"
      ]
    },
    "pageTreeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tokenRegistrySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sectionRegions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "width": {
            "type": "number",
            "minimum": 0
          },
          "height": {
            "type": "number",
            "minimum": 0
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "test-fixture",
                  "runtime"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "reference"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "width",
          "height",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "sectionConfigs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inlineGrid": {
            "type": "boolean"
          },
          "contentOrder": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "contentRows": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "padding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "top",
              "right",
              "bottom",
              "left"
            ],
            "properties": {
              "top": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^spacing\\.[a-zA-Z0-9_.-]+$"
                  }
                }
              },
              "right": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^spacing\\.[a-zA-Z0-9_.-]+$"
                  }
                }
              },
              "bottom": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^spacing\\.[a-zA-Z0-9_.-]+$"
                  }
                }
              },
              "left": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^spacing\\.[a-zA-Z0-9_.-]+$"
                  }
                }
              }
            }
          },
          "inlineOrder": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-design-skill:layout-plan:0.1.0"
}
