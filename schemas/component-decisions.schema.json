{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-design-skill:component-decisions:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "layoutTreeSha256",
    "registrySha256",
    "items"
  ],
  "properties": {
    "version": {
      "const": "0.1.0"
    },
    "layoutTreeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "registrySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "intent",
          "confidence",
          "rationale",
          "evidence",
          "preferredId",
          "variant"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "intent": {
            "enum": [
              "text",
              "choice",
              "hierarchy",
              "location",
              "date-range",
              "action",
              "records",
              "static"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "preferredId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "variant": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
