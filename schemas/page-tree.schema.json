{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "documentId",
    "analysisSha256",
    "stage",
    "page"
  ],
  "properties": {
    "version": {
      "const": "0.1.0"
    },
    "documentId": {
      "type": "string",
      "minLength": 1
    },
    "analysisSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stage": {
      "const": "page-tree"
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "identity",
        "primaryTask",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "Page"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "evidence"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "primaryTask": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "evidence"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "purpose",
              "children"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "Section"
              },
              "purpose": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "evidence"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "children": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "kind",
                    "description"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "enum": [
                        "fields",
                        "buttons",
                        "dataRegions",
                        "staticContent"
                      ]
                    },
                    "description": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "text",
                        "evidence"
                      ],
                      "properties": {
                        "text": {
                          "type": "string",
                          "minLength": 1
                        },
                        "evidence": {
                          "type": "array",
                          "minItems": 1,
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-design-skill:page-tree:0.1.0"
}
